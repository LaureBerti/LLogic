# The model replies themselves are published separately in data/llm_calls/.
outputs/
logs/
outputs/**/*.log
outputs/**/.hydra/
outputs/**/*.csv.predupe
outputs/**/*.csv.preretry

# OS / editor
.DS_Store
*.swp

