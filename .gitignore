# Environments
.venv/
venv/
__pycache__/
*.pyc

# Secrets — never commit
.env
*.key

# Large ontology files (download separately — see data/ontologies/README.md)
data/ontologies/*.owl
data/ontologies/*.rdf
data/ontologies/*.ttl
data/ontologies/*.nt

