# Environments
.venv/
venv/
__pycache__/
*.pyc

# Secrets — never commit
.env
*.key

# Large ontology files (download separately — see data/ontologies/README.md)
data/ontologies/*.owl
data/ontologies/*.rdf
data/ontologies/*.ttl
data/ontologies/*.nt

# Experiment outputs ARE tracked. Reviewer #1 asked for "a repository with the actual
# calls to the LLMs", and the replies live in the response_text column of every
# phase1_results.csv, so excluding outputs/ would leave that request unmet. ~55 MB.
logs/
outputs/**/*.log
outputs/**/.hydra/
outputs/**/*.csv.predupe
outputs/**/*.csv.preretry

# OS / editor
.DS_Store
*.swp

# Internal tooling guidance, not part of the published artifact
CLAUDE.md
