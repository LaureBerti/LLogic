  {
    "iri": "http://purl.obolibrary.org/obo/ENVO_01000756",
    "label": "obsolete vegetable",
    "depth": 2,
    "stratum": "root",
    "parents": [
      "http://www.w3.org/2002/07/owl#Thing"
